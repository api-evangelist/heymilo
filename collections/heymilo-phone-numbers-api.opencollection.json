{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyMilo Public ATS Phone Numbers API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phone Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/phone-numbers",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all phone numbers provisioned for the workspace."
        },
        {
          "info": {
            "name": "Get a phone number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/phone-numbers/:config_id",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "config_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single phone number configuration by ID."
        }
      ]
    }
  ],
  "bundled": true
}