{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyMilo Public ATS Health API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/health",
            "headers": [
              {
                "name": "X-Health-Detail",
                "value": ""
              }
            ]
          },
          "docs": "Health Check"
        }
      ]
    }
  ],
  "bundled": true
}