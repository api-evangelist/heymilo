{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyMilo Public ATS Schema Discovery API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schema Discovery",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agent types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/schemas/agents"
          },
          "docs": "Returns the registry of supported agent types and their configuration."
        },
        {
          "info": {
            "name": "List question types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/schemas/question-types"
          },
          "docs": "Returns the registry of supported question/criteria types by modality."
        }
      ]
    }
  ],
  "bundled": true
}