{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyMilo Public ATS Interviews API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Interviews",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get full interview data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/interviews/:interview_id/data",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "interview_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the full interview results across all workflow steps. Includes per-agent results (scorecard, transcript, resume evaluation, SMS screening, form results). Returns status 'not_ready' if the candidate has not finished."
        },
        {
          "info": {
            "name": "Get interview metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/interviews/:interview_id/metadata",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "interview_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the key-value metadata attached to a specific interview."
        },
        {
          "info": {
            "name": "Set interview metadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.heymilo.ai/api/v2/interviews/:interview_id/metadata",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "interview_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set or update metadata for a specific interview. Up to 50 keys, each key max 40 chars, each value max 500 chars. All values must be strings."
        },
        {
          "info": {
            "name": "Delete interview metadata",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.heymilo.ai/api/v2/interviews/:interview_id/metadata",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "interview_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove all metadata from a specific interview."
        }
      ]
    }
  ],
  "bundled": true
}