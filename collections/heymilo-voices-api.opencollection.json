{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyMilo Public ATS Voices API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List voices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/voices",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring filter applied to the voice name."
              }
            ]
          },
          "docs": "Returns all voices in the workspace voice registry."
        },
        {
          "info": {
            "name": "Get voice audio preview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/voices/:voice_id/preview",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "voice_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns an audio preview of the voice. May redirect (302) to an external audio URL."
        },
        {
          "info": {
            "name": "Get a voice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heymilo.ai/api/v2/voices/:voice_id",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "voice_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single voice from the workspace registry by ID."
        }
      ]
    }
  ],
  "bundled": true
}